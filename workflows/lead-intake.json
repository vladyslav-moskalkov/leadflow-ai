        "jsCode": "const name = $json.name;\nconst contact = $json.contact;\nconst email = $json.email;\nconst businessDescription = $json[\"business Description\"];\nconst automationGoals = $json[\"automation Goals\"];\n\nconst message = `\n🚀 New Lead — SYNTRA Labs\n\n────────────────────\n\n👤 Name\n${name}\n\n📱 Contact\n${contact}\n\n📧 Email\n${email}\n\n🏢 Business\n${businessDescription}\n\n⚙️ Automation Goals\n${automationGoals}\n\n────────────────────\n\n🔥 Status: New Lead\n`;\n\nreturn [\n  {\n    json: {\n      text: message,\n    },\n  },\n];"
      },
